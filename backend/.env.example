# ========================================
# THOZHI OTP BACKEND - ENVIRONMENT CONFIG
# ========================================

# Server
PORT=3001

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbName>?retryWrites=true&w=majority

# Optional OTP hash secret
OTP_SECRET=replace-with-a-long-random-secret

# Email (Gmail App Password - FREE)
# Go to: https://myaccount.google.com/apppasswords
# Generate an "App Password" for "Mail"
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Firebase Admin (Optional - for token verification)
# Download serviceAccountKey.json from Firebase Console
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
